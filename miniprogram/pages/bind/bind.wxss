.bind-hero { display: flex; flex-direction: column; align-items: center; padding: 0 0 24rpx; }
.bind-hero__emoji { font-size: 65rpx; color: var(--journal-coral); line-height: 1; }
.bind-hero__desc { margin-top: 7rpx; text-align: center; }
.invite-card, .input-card, .partner-card { padding: 28rpx; }
.card-label { color: var(--color-title); font-size: 29rpx; font-weight: 700; }
.code-row { display: flex; align-items: center; justify-content: center; margin: 22rpx 0; }
.code-row > button { width: auto !important; min-width: 0; margin: 0 0 0 14rpx; padding: 10rpx; }
.invite-code { letter-spacing: 12rpx; color: var(--color-primary-dark); font-size: 52rpx; font-weight: 700; padding-left: 12rpx; }
.regenerate { display: block; margin: 14rpx auto 0; font-size: 23rpx; }
.share-button { min-height: 74rpx; font-size: 27rpx; }
.bind-divider { display: flex; justify-content: center; align-items: center; color: var(--color-muted); margin: 18rpx 0; }
.bind-divider::before, .bind-divider::after { content: ''; width: 35%; border-top: 2rpx dashed var(--journal-stitch); margin: 0 20rpx; }
.code-input { margin: 18rpx 0; min-height: 78rpx; text-align: center; letter-spacing: 4rpx; padding: 10rpx; font-size: 29rpx; }
.hint { display: block; margin-top: 20rpx; color: var(--color-muted); font-size: 21rpx; text-align: center; }
.copy-hint { margin-top: 0; }
.hint--error { color: var(--color-danger); }
.partner-card { margin-top: 24rpx; display: flex; align-items: center; }
.partner-card > view, .partner-card > button { margin-left: 18rpx; }
.partner-card view:nth-child(2) { flex: 1; min-width: 0; display: flex; flex-direction: column; overflow-wrap: break-word; }
.partner-card view:nth-child(2) text + text { margin-top: 8rpx; }
.partner-name { color: var(--color-title); font-weight: 700; }
.partner-date { color: var(--color-muted); font-size: 22rpx; }
.unlink { flex: none; width: auto !important; min-width: 0; font-size: 22rpx; color: var(--color-danger); }
