.photo-swiper, .photo-swiper image, .detail-placeholder { width: 100%; height: 430rpx; border-radius: 27rpx; overflow: hidden; }
.photo-swiper { border: 3rpx solid var(--journal-outline); box-shadow: var(--shadow-card); }
.detail-placeholder { display: flex; align-items: center; justify-content: center; background: #f1e2ca; font-size: 75rpx; }
.detail-placeholder text { margin-left: 10rpx; color: var(--journal-muted); font-size: 26rpx; }
.photo-empty { min-height: 279rpx; display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 25rpx; }
.photo-empty .journal-title { margin: 18rpx 0 14rpx; }
.detail-card { margin-top: 24rpx; }
.detail-title-row { display: flex; align-items: flex-start; justify-content: space-between; }
.detail-identity { flex: 1; min-width: 0; }
.detail-name { display: block; font-size: 39rpx; line-height: 1.25; font-weight: 800; overflow-wrap: break-word; }
.detail-category { margin-top: 9rpx; }
.edit-button { flex: none; margin-left: 12rpx; }
.lock-state { display: flex; flex-direction: column; margin-top: 20rpx; padding: 14rpx 17rpx; border-radius: 14rpx; background: #fae4ac; }
.lock-badge { color: var(--journal-ink); font-size: 26rpx; font-weight: 750; }
.locked-actions { margin-top: 5rpx; color: var(--journal-muted); font-size: 23rpx; }
.rating-row { display: flex; align-items: center; margin: 15rpx 0; }
.heart-rating { display: flex; align-items: center; justify-content: center; flex: 1; min-width: 0; width: 0 !important; min-height: 72rpx; margin: 0; padding: 0; color: #885244; background: transparent; font-size: 42rpx; }
.heart-rating--selected { color: var(--journal-coral); }
.rating-hint, .date { color: var(--journal-muted); font-size: 23rpx; }
.rating-hint { flex: none; margin-left: 10rpx; }
.review { display: block; background: #f9efd8; border-radius: 14rpx; color: var(--journal-ink); padding: 17rpx; font-size: 25rpx; line-height: 1.6; overflow-wrap: break-word; }
.date { display: block; margin-top: 16rpx; }
.detail-actions { border-top: 2rpx dashed var(--journal-stitch); display: flex; align-items: center; justify-content: space-between; margin-top: 20rpx; padding-top: 12rpx; }
.like-button--active { background: var(--journal-pink); border-color: #a16f62; }
.detail-actions .danger-link { margin-left: auto; }
.missing-recipe { text-align: center; }
