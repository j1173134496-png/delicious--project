<view class="journal-page journal-inset detail-page">
  <view wx:if="{{recipe.recipeId}}">
    <swiper class="photo-swiper" aria-label="菜品照片预览" indicator-dots="true" circular="true" wx:if="{{photoItems.length}}"><swiper-item wx:for="{{photoItems}}" wx:key="path"><image wx:if="{{item.hasImage}}" src="{{item.imagePath}}" mode="aspectFill" data-index="{{index}}" binderror="onPhotoError" /><view wx:else class="detail-placeholder">📷<text>照片占位</text></view></swiper-item></swiper>
    <view class="photo-empty journal-sheet" wx:else>
      <view class="journal-tape" aria-hidden="true"></view><view class="journal-camera" aria-hidden="true">＋</view>
      <text class="journal-title">{{recipe.isUnlocked ? '还没有照片' : '还没吃过哦～'}}</text>
      <button class="secondary-button journal-compact" loading="{{addingPhoto}}" disabled="{{addingPhoto || deleting}}" bindtap="choosePhoto">{{recipe.isUnlocked ? '补充照片' : '补充照片解锁'}}</button>
    </view>
    <view class="detail-card journal-sheet journal-panel">
      <view class="detail-title-row"><view class="detail-identity"><text class="detail-name">{{recipe.name}}</text><text class="detail-category journal-chip">{{recipe.category === 'dessert' ? '甜品区' : recipe.category === 'hunan' ? '湘菜' : '自定义'}}</text></view><button class="edit-button journal-chip journal-compact" aria-label="编辑菜品" disabled="{{updating || deleting}}" bindtap="edit">编辑菜品</button></view>
      <view class="lock-state" wx:if="{{!recipe.isUnlocked}}"><text class="lock-badge">待解锁</text><text class="locked-actions">添加一张照片后可评分和点赞。</text></view>
      <view class="rating-row" wx:if="{{recipe.isUnlocked}}"><button class="heart-rating {{item <= recipe.rating ? 'heart-rating--selected' : ''}}" wx:for="{{ratingValues}}" wx:key="*this" data-rating="{{item}}" aria-label="评分 {{item}} / 5，{{item <= recipe.rating ? '已选' : '未选'}}" disabled="{{updating || deleting}}" bindtap="rate">{{item <= recipe.rating ? '♥' : '♡'}}</button><text class="rating-hint">{{recipe.rating || 0}} / 5</text></view>
      <text class="review" wx:if="{{recipe.review}}">“{{recipe.review}}”</text><text class="date" wx:if="{{recipe.unlockedDate}}">解锁于 {{recipe.unlockedDate}}</text>
      <view class="detail-actions"><button wx:if="{{recipe.isUnlocked}}" class="secondary-button journal-compact like-button {{liked ? 'like-button--active' : ''}}" aria-label="{{liked ? '取消点赞' : '点赞'}}，共 {{recipe.likes.length}} 次" loading="{{updating}}" disabled="{{updating || deleting}}" bindtap="toggleLike">{{liked ? '取消点赞' : '点赞'}} {{recipe.likes.length}}</button><button class="ghost-button journal-compact danger-link" loading="{{deleting}}" disabled="{{deleting || updating}}" bindtap="remove">删除这道菜</button></view>
    </view>
  </view>
  <view wx:else class="journal-sheet journal-panel missing-recipe"><text class="journal-title">找不到这道菜</text><button class="journal-primary journal-action" bindtap="goRecipe">回到菜谱图鉴</button></view>
</view>
