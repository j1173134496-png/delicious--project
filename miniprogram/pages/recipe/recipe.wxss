.recipe-page { display: flex; flex-direction: column; height: 100vh; overflow: hidden; }
.recipe-heading { display: flex; align-items: center; justify-content: space-between; flex: none; padding: 28rpx 28rpx 20rpx; }
.recipe-heading__copy { min-width: 0; }
.recipe-title { display: block; font-size: 49rpx; line-height: 1.1; font-weight: 800; }
.recipe-subtitle { display: block; margin-top: 11rpx; color: var(--journal-muted); font-size: 24rpx; line-height: 1.35; }
.recipe-total { flex: none; min-width: 126rpx; margin-left: 18rpx; padding: 10rpx 13rpx; text-align: center; background: var(--journal-paper); border: 2rpx solid var(--journal-outline); border-radius: 17rpx 17rpx 22rpx 14rpx; box-shadow: 4rpx 4rpx 0 rgba(112,77,60,.18); transform: rotate(4deg); }
.recipe-total__label { display: block; font-size: 21rpx; line-height: 1.2; }
.recipe-total__count { color: var(--journal-coral); font-size: 34rpx; font-weight: 800; line-height: 1.15; }
.recipe-total__unit { font-size: 22rpx; font-weight: 600; }

.recipe-tabs { display: flex; flex: none; padding: 0 28rpx 21rpx; }
.recipe-tab { display: flex; flex-direction: column; align-items: center; justify-content: center; flex: 1; min-width: 0; width: auto; min-height: 116rpx; border: 2rpx solid var(--journal-outline); border-radius: 17rpx 17rpx 29rpx 17rpx; background: #f3e9dc; color: var(--journal-ink); box-shadow: 3rpx 4rpx 0 rgba(112,77,60,.17); padding: 9rpx 3rpx; line-height: 1.2; }
.recipe-tab__heading { display: flex; align-items: center; justify-content: center; }
.recipe-tab + .recipe-tab { margin-left: 12rpx; }
.recipe-tab__label { margin-left: 7rpx; font-size: 27rpx; font-weight: 700; }
.recipe-tab-count { display: block; margin-top: 5rpx; font-size: 21rpx; color: var(--journal-muted); }
.recipe-tab-state { display: block; margin-top: 4rpx; font-size: 19rpx; color: var(--journal-ink); }
.recipe-tab--active { background: var(--journal-honey); border-width: 3rpx; box-shadow: inset 0 0 0 4rpx #fff6db, 3rpx 4rpx 0 rgba(112,77,60,.23); }
.recipe-tab--pressed { background: #f2d8b0; }
.recipe-tab__icon { position: relative; flex: none; width: 24rpx; height: 24rpx; }
.recipe-tab__icon--locked { height: 16rpx; margin-top: 6rpx; border: 2rpx solid var(--journal-outline); border-radius: 4rpx; background: #ebbb6d; }
.recipe-tab__icon--locked::before { content: ''; position: absolute; top: -10rpx; left: 4rpx; width: 10rpx; height: 9rpx; border: 2rpx solid var(--journal-outline); border-bottom: 0; border-radius: 8rpx 8rpx 0 0; }
.recipe-tab__icon--unlocked { width: 22rpx; height: 22rpx; border: 3rpx solid var(--journal-outline); border-radius: 50%; background: #f3d3a3; }
.recipe-tab__icon--unlocked::after { content: ''; position: absolute; right: -5rpx; bottom: -3rpx; width: 9rpx; height: 3rpx; background: var(--journal-outline); transform: rotate(48deg); }
.recipe-tab__icon--dessert { height: 17rpx; margin-top: 4rpx; border: 2rpx solid var(--journal-outline); border-radius: 5rpx; background: linear-gradient(#f5b4a5 55%, #fff5d6 55%); }
.recipe-tab__icon--dessert::before { content: ''; position: absolute; top: -7rpx; left: 6rpx; width: 8rpx; height: 7rpx; background: #d36e69; border: 1rpx solid var(--journal-outline); border-radius: 6rpx 6rpx 0 0; }

/* Separate the scrolling list from its action dock so no card sits under the CTA. */
.recipe-scroll { flex: 1; height: 0; min-height: 0; width: 100%; }
.recipe-grid { display: flex; flex-wrap: wrap; padding: 3rpx 28rpx 16rpx; }
.recipe-cell { box-sizing: border-box; min-width: 0; width: 50%; padding: 0 9rpx 19rpx 0; }
.recipe-cell:nth-child(even) { padding-right: 0; padding-left: 9rpx; }
.recipe-empty { margin: 14rpx 28rpx 18rpx; padding: 45rpx 27rpx 43rpx; text-align: center; }
.recipe-empty__mark { display: block; color: var(--journal-coral); font-size: 48rpx; line-height: 1.15; }
.recipe-empty__title { display: block; margin-top: 14rpx; font-size: 29rpx; font-weight: 700; }
.recipe-empty__hint { display: block; margin-top: 13rpx; color: var(--journal-muted); font-size: 24rpx; line-height: 1.5; }
.recipe-dock { flex: none; display: flex; justify-content: center; padding: 10rpx 28rpx 18rpx; border-top: 2rpx dashed #c29b74; background: #f8e8c5; }
.recipe-add-button { min-width: 225rpx; min-height: 78rpx; }
.recipe-add-button__icon { margin-right: 7rpx; font-size: 34rpx; }
