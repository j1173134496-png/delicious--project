.intro-card, .content-card { margin-top: 24rpx; padding: 30rpx; }
.intro-card { display: flex; flex-direction: column; align-items: center; text-align: center; margin-top: 0; }
.intro-emoji { font-size: 65rpx; color: var(--journal-coral); line-height: 1; margin-bottom: 13rpx; }
.intro-card .page-subtitle { margin-top: 12rpx; }
.content-card { display: flex; flex-direction: column; }
.section-title { color: var(--color-title); font-size: 30rpx; font-weight: 700; }
.body-text { color: var(--color-text); font-size: 25rpx; line-height: 1.75; margin-top: 18rpx; }
.action-hint { display: block; color: var(--color-muted); font-size: 23rpx; line-height: 1.6; text-align: center; margin: 24rpx 12rpx 0; }
