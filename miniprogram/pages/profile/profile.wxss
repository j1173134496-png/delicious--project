.profile-hero { display: flex; align-items: center; }
.profile-hero > .profile-hero__copy, .profile-hero > .edit-link { margin-left: 22rpx; }
.profile-hero__avatar, .profile-hero > .edit-link { flex-shrink: 0; }
.profile-hero__copy { flex: 1; min-width: 0; display: flex; flex-direction: column; }
.profile-hero__copy text + text { margin-top: 10rpx; }
.profile-name { color: var(--color-title); font-size: 36rpx; font-weight: 750; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.profile-signature { display: block; min-width: 0; overflow: hidden; color: var(--color-muted); font-size: 23rpx; text-overflow: ellipsis; white-space: nowrap; }
.profile-info { margin-top: 23rpx; padding-top: 18rpx; display: flex; border-top: 2rpx dashed var(--journal-stitch); }
.info-row { min-width: 0; flex: 1; display: flex; flex-direction: column; padding: 0 10rpx; color: var(--journal-muted); font-size: 22rpx; }
.info-row + .info-row { border-left: 2rpx solid #e4cbb1; }
.info-row text:last-child { margin-top: 5rpx; color: var(--journal-ink); font-size: 23rpx; overflow-wrap: break-word; }
.couple-card, .stats-card { margin-top: 24rpx; padding: 23rpx 26rpx; }
.section-head { display: flex; align-items: center; justify-content: space-between; }
.section-title { font-size: 30rpx; font-weight: 700; color: var(--color-title); }
.couple-layout { display: flex; align-items: center; margin-top: 15rpx; }
.couple-identity { flex: 1; min-width: 0; }
.couple-commands { width: 47%; min-width: 0; margin-left: 14rpx; }
.couple-avatars { display: flex; align-items: center; justify-content: center; padding: 5rpx 0 10rpx; }
.couple-avatars > avatar + text, .couple-avatars > text + avatar { margin-left: 16rpx; }
.couple-heart { color: var(--color-primary-dark); font-size: 38rpx; animation: pulse-soft 1.8s ease-in-out infinite; }
.couple-status { display: block; text-align: center; color: var(--color-title); font-size: 23rpx; overflow-wrap: break-word; }
.accent { color: var(--color-primary-dark); font-size: 34rpx; font-weight: 700; }
.couple-button { min-height: 68rpx; width: 100% !important; min-width: 0; margin: 0; padding: 9rpx 8rpx; font-size: 23rpx; }
.profile-share-button { display: block; margin: 7rpx auto 0; min-height: 55rpx; }
.cat-summary { display: flex; align-items: center; margin: 22rpx 0; }
.cat-summary > .cat-summary__copy { margin-left: 18rpx; }
.cat-summary-visual { width: 100rpx; height: 100rpx; display: flex; align-items: center; justify-content: center; flex: 0 0 100rpx; }
.cat-summary-image { width: 100%; height: 100%; display: block; }
.cat-emoji { width: 86rpx; height: 86rpx; border-radius: 26rpx; background: var(--color-yellow); display: flex; align-items: center; justify-content: center; font-size: 52rpx; }
.cat-summary__copy { flex: 1; color: var(--color-muted); font-size: 23rpx; }
.cat-state { display: block; color: var(--journal-ink); font-size: 25rpx; font-weight: 700; }
.cat-state-note { display: block; color: var(--color-muted); font-size: 20rpx; line-height: 1.5; margin-bottom: 6rpx; }
.cat-transition-tip { color: var(--color-primary-dark); }
.progress-track { height: 14rpx; background: #ead9c5; border-radius: 999rpx; margin-top: 12rpx; overflow: hidden; }
.progress-value { height: 100%; border-radius: 999rpx; background: #946ca4; }
.experience-caption { display: block; margin-top: 7rpx; text-align: right; }
.level-chip { background: var(--color-lavender); color: var(--color-title); border: 2rpx solid #9b7ea5; border-radius: 999rpx; padding: 8rpx 14rpx; font-size: 22rpx; }
.stat-grid { display: flex; text-align: center; border-top: 2rpx dashed var(--journal-stitch); padding-top: 17rpx; }
.stat-grid > view { flex: 1; display: flex; flex-direction: column; }
.stat-grid > view text + text { margin-top: 6rpx; }
.stat-number { font-size: 34rpx; color: var(--color-primary-dark); font-weight: 700; }
.stat-label { color: var(--color-muted); font-size: 22rpx; }
.stat-grid--wide { flex-wrap: wrap; }
.stat-grid--wide > view { min-width: 20%; padding: 0 4rpx; box-sizing: border-box; }
.growth-next { margin-top: 18rpx; padding: 13rpx 16rpx; border-radius: 15rpx; background: #fae4ac; }
.growth-complete, .next-title { color: var(--color-title); font-size: 25rpx; font-weight: 700; }
.condition-row { display: flex; align-items: center; margin-top: 16rpx; color: var(--color-muted); font-size: 22rpx; }
.condition-row > text:nth-child(1) { flex: 1; }
.condition-row > text + text { margin-left: 12rpx; }
.condition-remaining { color: var(--color-primary-dark); }
.condition-ready { color: #426746; }
.menu-card { display: flex; margin-top: 24rpx; }
.menu-row { flex: 1; min-width: 0; min-height: 76rpx; width: 0 !important; display: flex; align-items: center; justify-content: center; margin: 0; padding: 8rpx 5rpx; border-radius: 999rpx; border: 2rpx solid var(--journal-outline); background: var(--journal-paper); color: var(--journal-ink); box-shadow: var(--shadow-card); font-size: 23rpx; }
.menu-row + .menu-row { margin-left: 12rpx; }
.menu-icon, .menu-arrow { font-size: 28rpx; color: var(--journal-muted); margin: 0 8rpx; }
