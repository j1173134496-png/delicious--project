.add-page { min-height: 100vh; padding: 32rpx 27rpx 37rpx; padding-bottom: calc(37rpx + env(safe-area-inset-bottom)); }
.recipe-form, .photo-picker { padding: 22rpx 28rpx 25rpx; margin-bottom: 22rpx; }
.form-row { display: flex; justify-content: space-between; align-items: center; min-height: 97rpx; padding: 8rpx 0; border-bottom: 2rpx dashed var(--journal-stitch); }
.form-heading { display: flex; align-items: center; justify-content: space-between; }
.form-label { color: var(--journal-ink); font-size: 30rpx; line-height: 1.3; font-weight: 750; }
.form-row .form-label { flex: none; min-width: 113rpx; }
.form-input { flex: 1; min-width: 0; margin-left: 16rpx; height: 72rpx; background: var(--journal-field); color: var(--journal-ink); border: 2rpx solid var(--journal-outline); border-radius: 38rpx; padding: 0 23rpx; font-size: 27rpx; }
.form-placeholder { color: #826753; }
.form-category { max-width: 100%; }
.picker-value { justify-content: center; min-height: 61rpx; min-width: 133rpx; padding: 8rpx 19rpx; font-size: 27rpx; }
.picker-arrow { margin-left: 11rpx; font-size: 21rpx; }
.form-section { padding-top: 21rpx; }
.rating-readable { color: var(--journal-muted); font-size: 23rpx; }
.rating-count { color: var(--journal-ink); font-weight: 750; }
.rating-picker { display: flex; justify-content: space-between; margin-top: 7rpx; }
.rating-heart { display: flex; align-items: center; justify-content: center; width: auto; min-width: 0; flex: 1; min-height: 88rpx; font-size: 47rpx; line-height: 1; color: #885244; background: transparent; border-radius: 18rpx; }
.rating-heart + .rating-heart { margin-left: 8rpx; }
.rating-heart--selected { color: var(--journal-coral); }
.rating-heart--pressed { background: #f9dfcf; }
.review-section { padding-top: 9rpx; }
.form-textarea { margin-top: 13rpx; width: 100%; height: 123rpx; padding: 15rpx 19rpx; border: 2rpx solid var(--journal-outline); border-radius: 22rpx; color: var(--journal-ink); background: #f9eed8; font-size: 25rpx; line-height: 1.5; }

.photo-picker { padding-top: 25rpx; }
.photo-count { color: var(--journal-muted); font-size: 25rpx; font-weight: 600; }
.photo-grid { margin-top: 16rpx; display: flex; flex-wrap: wrap; }
.photo-item, .photo-add { flex: none; width: calc(33.333% - 8rpx); min-width: 0; margin: 0 12rpx 12rpx 0; height: 147rpx; border-radius: 18rpx; overflow: hidden; }
.photo-item:nth-child(3n), .photo-add:nth-child(3n) { margin-right: 0; }
.photo-item { border: 2rpx solid var(--journal-outline); }
.photo-thumb { display: block; width: 100%; height: 100%; }
.photo-placeholder, .photo-add { display: flex; flex-direction: column; justify-content: center; align-items: center; background: #f5e5c8; color: var(--journal-ink); font-size: 23rpx; line-height: 1.2; }
.photo-placeholder { width: 100%; height: 100%; }
.photo-placeholder .photo-camera, .photo-add .photo-camera { margin-bottom: 11rpx; }
.photo-add { width: calc(33.333% - 8rpx) !important; background: var(--journal-field); border: 2rpx dashed var(--journal-outline); }
.photo-add--pressed { background: #f6e5bf; }
.photo-add[disabled] { background: #f3e7d6; color: var(--journal-muted); }
.photo-add__label { font-weight: 700; }
.photo-camera { position: relative; display: flex; align-items: center; justify-content: center; width: 53rpx; height: 37rpx; border: 3rpx solid var(--journal-outline); border-radius: 9rpx; background: #f6d8aa; font-size: 25rpx; line-height: 1; }
.photo-camera::before { content: ''; position: absolute; top: -10rpx; left: 4rpx; width: 18rpx; height: 8rpx; border: 3rpx solid var(--journal-outline); border-bottom: 0; border-radius: 5rpx 5rpx 0 0; background: #f6d8aa; }
.photo-camera::after { content: ''; position: absolute; width: 20rpx; height: 20rpx; border: 2rpx solid var(--journal-outline); border-radius: 50%; }
.photo-camera--add::after { width: 23rpx; height: 23rpx; }
.photo-note { flex: 1; min-width: 0; margin-bottom: 12rpx; display: flex; align-items: center; justify-content: center; padding: 0 13rpx; }
.photo-note__spark { flex: none; color: #ad6429; font-size: 43rpx; transform: rotate(12deg); }
.photo-note__copy { margin-left: 10rpx; color: var(--journal-muted); font-size: 24rpx; line-height: 1.4; }
.photo-hint, .photo-capability { display: block; padding: 9rpx 14rpx; margin-top: 4rpx; color: var(--journal-ink); background: #fae4ac; border-radius: 17rpx; text-align: center; font-size: 22rpx; line-height: 1.4; }
.photo-capability { background: #f9dfcf; color: #683b2f; }
.save-button { width: 66%; margin: 4rpx auto 0; }
