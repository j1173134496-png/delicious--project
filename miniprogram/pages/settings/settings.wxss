.settings-heading { margin: 0 8rpx 18rpx; }
.settings-heading .journal-hint { margin-top: 5rpx; }
.settings-group { padding: 0 28rpx; margin-bottom: 24rpx; }
.setting-row { min-height: 128rpx; display: flex; align-items: center; justify-content: space-between; border-bottom: 2rpx dashed var(--journal-stitch); }
.setting-row > view { margin-right: 18rpx; }
.setting-row:last-child { border-bottom: 0; }
.setting-row view { display: flex; flex-direction: column; }
.setting-row view text + text { margin-top: 8rpx; }
.setting-title { color: var(--color-title); font-size: 28rpx; }
.setting-desc { color: var(--color-muted); font-size: 23rpx; }
.setting-state { color: var(--color-primary-dark); font-size: 20rpx; margin-top: 6rpx; }
.settings-links { padding-top: 4rpx; padding-bottom: 4rpx; }
.setting-link { min-height: 88rpx; display: flex; align-items: center; justify-content: space-between; color: var(--color-title); border-bottom: 2rpx dashed var(--journal-stitch); }
.setting-link:last-child { border-bottom: 0; }
.setting-link text:last-child { color: var(--color-muted); font-size: 36rpx; }
.danger-card { padding: 22rpx 26rpx; background: #fff4e9; border-color: #ad7468; }
.danger-button { color: var(--color-danger); background: #fae2db; width: 100% !important; margin-top: 16rpx; border: 2rpx solid #b67668; border-radius: 999rpx; font-size: 26rpx; font-weight: 700; padding: 13rpx; }
.danger-card > text { display: block; color: var(--color-muted); font-size: 23rpx; line-height: 1.5; margin-top: 8rpx; }
.danger-card > .danger-label { font-size: 28rpx; font-weight: 700; color: var(--journal-ink); }
.danger-card > .clear-error { color: #A05A67; }
.version { display: block; color: var(--journal-muted); font-size: 22rpx; text-align: center; margin-top: 25rpx; }
