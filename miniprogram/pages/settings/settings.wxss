.settings-page { padding-top: 12rpx; }
.settings-group { padding: 0 28rpx; margin-bottom: 24rpx; }
.setting-row { min-height: 112rpx; display: flex; align-items: center; justify-content: space-between; border-bottom: 1rpx solid #F5EDF2; }
.setting-row > view { margin-right: 18rpx; }
.setting-row:last-child { border-bottom: 0; }
.setting-row view { display: flex; flex-direction: column; }
.setting-row view text + text { margin-top: 8rpx; }
.setting-title { color: var(--color-title); font-size: 28rpx; }
.setting-desc { color: var(--color-muted); font-size: 21rpx; }
.setting-state { color: var(--color-primary-dark); font-size: 20rpx; margin-top: 6rpx; }
.settings-links { padding-top: 4rpx; padding-bottom: 4rpx; }
.setting-link { min-height: 90rpx; display: flex; align-items: center; justify-content: space-between; color: var(--color-title); border-bottom: 1rpx solid #F5EDF2; }
.setting-link:last-child { border-bottom: 0; }
.setting-link text:last-child { color: var(--color-muted); font-size: 36rpx; }
.danger-card { padding: 26rpx; text-align: center; }
.danger-button { color: var(--color-danger); background: #FFF0F2; width: 100%; border-radius: 999rpx; font-size: 27rpx; padding: 18rpx; }
.danger-card > text { display: block; color: var(--color-muted); font-size: 21rpx; margin-top: 14rpx; }
.danger-card > .clear-error { color: #A05A67; }
.version { display: block; color: #C5ACBF; font-size: 20rpx; text-align: center; margin-top: 36rpx; }
