<view class="cat-display {{stateClass}} {{reducedMotion ? 'cat-display--reduced' : ''}}" aria-label="{{formName}}，当前状态：{{stateText}}，点击或长按摸摸{{assetFallback === 'emoji' ? '，显示 Emoji 占位' : ''}}" bindtap="onPet" bindlongpress="onPet">
  <view class="cat-face {{hasImage ? 'cat-face--with-image' : ''}}"><image wx:if="{{hasImage}}" class="cat-image" src="{{imagePath}}" data-src="{{imagePath}}" mode="aspectFit" binderror="onImageError" /><text wx:else class="cat-emoji">{{emoji}}</text><text class="cat-bow" wx:if="{{!hasImage && cat.level >= 2}}">🎀</text></view>
  <text wx:if="{{stateClass !== 'cat-display--idle'}}" class="cat-form" aria-live="polite">{{stateText}}</text>
</view>
