.cat-display { position: relative; min-height: 360rpx; display: flex; align-items: center; flex-direction: column; justify-content: center; overflow: hidden; perspective: 900rpx; }
.cat-face { width: 230rpx; height: 230rpx; border-radius: 45% 45% 48% 48%; background: linear-gradient(145deg, #FFF3B0, #FFE0B8); display: flex; align-items: center; justify-content: center; position: relative; box-shadow: 0 18rpx 0 #EEC3B0; transform: translate3d(0, 0, 0) rotateX(2deg); transition: transform .35s ease, filter .35s ease; }
.cat-face--with-image { width: 300rpx; height: 300rpx; border-radius: 0; background: transparent; box-shadow: none; }
.cat-image { width: 100%; height: 100%; display: block; }
.cat-emoji { font-size: 150rpx; line-height: 1; filter: drop-shadow(0 8rpx 5rpx rgba(150, 100, 100, .15)); }
.cat-bow { position: absolute; right: 4rpx; top: 8rpx; font-size: 48rpx; }
.cat-name { margin-top: 26rpx; color: var(--color-title); font-weight: 700; font-size: 32rpx; }
.cat-form { margin-top: 8rpx; color: var(--color-muted); font-size: 22rpx; }
.cat-interaction-hint, .cat-asset-hint { display: block; max-width: 620rpx; margin-top: 8rpx; color: var(--color-muted); font-size: 20rpx; line-height: 1.5; text-align: center; }
.cat-asset-hint { color: var(--color-primary-dark); }
.cat-sparkle { position: absolute; color: #F3C858; font-size: 38rpx; animation: pulse-soft 1.8s ease-in-out infinite; }
.sparkle-a { left: 18%; top: 20%; }.sparkle-b { right: 20%; top: 38%; font-size: 50rpx; }
.cat-display--idle .cat-face { animation: floaty 2.8s ease-in-out infinite; }
.cat-display--happy .cat-face { animation: pulse-soft .7s ease-in-out 2; }
.cat-display--eating .cat-face { animation: pulse-soft .45s ease-in-out 4; }
.cat-display--sad .cat-face { filter: grayscale(.2); transform: translateY(8rpx); }
.cat-display--reduced .cat-face, .cat-display--reduced .cat-sparkle { animation: none; transition: none; }
.cat-display--reduced .cat-face { transform: none; }
