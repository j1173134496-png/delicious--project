.cat-display { position: relative; width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; perspective: 900rpx; }
.cat-face { width: 213rpx; height: 213rpx; border-radius: 45% 45% 48% 48%; background: #fff0cc; display: flex; align-items: center; justify-content: center; position: relative; box-shadow: 0 12rpx 0 #d5b18c; transform: translate3d(0, 0, 0) rotateX(2deg); transition: transform .35s ease, filter .35s ease; }
.cat-face--with-image { width: 100%; height: 100%; border-radius: 0; background: transparent; box-shadow: none; }
.cat-image { width: 100%; height: 100%; display: block; }
.cat-emoji { font-size: 150rpx; line-height: 1; filter: drop-shadow(0 8rpx 5rpx rgba(150, 100, 100, .15)); }
.cat-bow { position: absolute; right: 4rpx; top: 8rpx; font-size: 48rpx; }
.cat-form { position: absolute; left: 50%; top: -19rpx; transform: translateX(-50%); padding: 4rpx 13rpx; border: 2rpx solid #a98561; border-radius: 999rpx; background: #fff8e4; color: #5b3b2d; white-space: nowrap; font-size: 21rpx; font-weight: 600; }
.cat-display--idle .cat-face { transform: none; }
.cat-display--happy .cat-face { animation: pulse-soft .7s ease-in-out 2; }
.cat-display--eating .cat-face { animation: pulse-soft .45s ease-in-out 4; }
.cat-display--sad .cat-face { transform: translateY(3rpx); }
.cat-display--reduced .cat-face { animation: none; transition: none; }
.cat-display--reduced .cat-face { transform: none; }
@media (prefers-reduced-motion: reduce) {
  .cat-display .cat-face { animation: none; transition: none; }
}
