.bubble-row { display: flex; align-items: flex-start; margin-bottom: 22rpx; }
.bubble-row--cat > .bubble { margin-left: 18rpx; max-width: 70%; }
.bubble-row--user > .bubble-avatar--user { margin-left: 14rpx; }
.bubble-row--user { justify-content: flex-end; }
.bubble-avatar { box-sizing: border-box; width: 95rpx; height: 95rpx; border-radius: 50%; background: #f8dfa3; border: 2rpx solid #997046; box-shadow: inset 0 0 0 4rpx #ffefc7; display: flex; justify-content: center; align-items: center; font-size: 34rpx; flex-shrink: 0; }
.bubble-avatar-image { width: 81rpx; height: 81rpx; }
.bubble-row--cat .bubble { font-size: 29rpx; }
.bubble-avatar--user { width: 62rpx; height: 62rpx; background: var(--color-lavender); color: var(--color-title); font-size: 23rpx; border: 0; box-shadow: none; }
.bubble { box-sizing: border-box; max-width: 79%; min-width: 0; position: relative; padding: 15rpx 19rpx; border: 2rpx solid #aa845d; border-radius: 8rpx 23rpx 23rpx 23rpx; background: #ffedc4; color: #41271d; box-shadow: 3rpx 4rpx 0 #ead0aa; font-size: 26rpx; line-height: 1.55; overflow-wrap: break-word; }
.bubble-row--user .bubble { border-radius: 23rpx 8rpx 23rpx 23rpx; background: #efddf4; color: #41271d; border-color: #a184ae; }
.bubble-row--cat > .bubble:not(.bubble--care) { border-radius: 21rpx 25rpx 22rpx 24rpx; background: #fff1cf; }
.bubble-row--cat > .bubble::before { content: ''; position: absolute; left: -7rpx; top: 29rpx; width: 11rpx; height: 11rpx; transform: rotate(45deg); background: inherit; border-left: 2rpx solid #aa845d; border-bottom: 2rpx solid #aa845d; }
.bubble-row--cat > .bubble--care::before { border-color: #8a9e73; }
.bubble-time { display: block; text-align: right; font-size: 19rpx; margin-top: 7rpx; color: var(--color-muted); opacity: .9; }
.bubble-row--user .bubble-time { color: #634d69; }
.bubble--care { background: #e5edd5; border-color: #8a9e73; }
.bubble-care-label { display: block; color: #486345; font-size: 22rpx; margin-bottom: 6rpx; }
