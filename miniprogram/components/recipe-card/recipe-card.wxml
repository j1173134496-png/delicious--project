<button class="recipe-card" aria-label="{{recipe.name}}，{{recipe.isUnlocked ? '已解锁，评分 ' + (recipe.rating || 0) + ' / 5' : '未解锁'}}，点击查看详情" hover-class="recipe-card--pressed" bindtap="onTap">
  <view class="recipe-cover">
    <image wx:if="{{hasImage}}" class="recipe-cover__image" src="{{imagePath}}" mode="aspectFill" binderror="onImageError" />
    <view wx:else class="recipe-placeholder {{recipe.isUnlocked ? 'recipe-placeholder--photo' : ''}}">
      <view wx:if="{{recipe.isUnlocked}}" class="recipe-card-camera" aria-hidden="true"></view>
      <view wx:else class="recipe-drawing" aria-hidden="true">
        <text class="recipe-drawing__star">✦</text>
        <text class="recipe-drawing__question">?</text>
        <view class="recipe-drawing__plate"></view>
        <view class="recipe-drawing__cloche"></view>
        <view class="recipe-drawing__handle"></view>
        <view class="recipe-drawing__lock"></view>
      </view>
      <text wx:if="{{recipe.isUnlocked}}" class="recipe-placeholder-label">照片占位</text>
    </view>
    <text wx:if="{{!recipe.isUnlocked}}" class="lock-badge">待解锁</text>
  </view>
  <view class="recipe-copy">
    <text class="recipe-name">{{recipe.name}}</text>
    <text class="recipe-status-text" wx:if="{{!recipe.isUnlocked}}">补充照片解锁</text>
    <view class="recipe-rating" wx:else>
      <text class="recipe-rating__hearts" aria-hidden="true">{{stars}}</text>
      <text class="recipe-rating__value">{{recipe.rating || 0}}/5</text>
    </view>
    <text class="recipe-date" wx:if="{{recipe.isUnlocked && recipe.unlockedDate}}">{{recipe.unlockedDate}} 解锁</text>
  </view>
</button>
