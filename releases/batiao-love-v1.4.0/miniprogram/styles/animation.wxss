@keyframes floaty { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-10rpx); } }
@keyframes pulse-soft { 0%, 100% { transform: scale(1); } 50% { transform: scale(1.04); } }
@keyframes heart-rise { 0% { opacity: 0; transform: translateY(20rpx) scale(.7); } 30% { opacity: 1; } 100% { opacity: 0; transform: translateY(-120rpx) scale(1.15); } }
.floaty { animation: floaty 2.8s ease-in-out infinite; }
.pulse-soft { animation: pulse-soft 1.6s ease-in-out infinite; }
