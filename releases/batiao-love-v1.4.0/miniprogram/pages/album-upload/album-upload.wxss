.upload-page { padding-top: 12rpx; }
.upload-card, .form-card { padding: 26rpx 28rpx; margin-bottom: 24rpx; }
.upload-head { display: flex; justify-content: space-between; align-items: center; }
.form-label { color: var(--color-title); font-size: 27rpx; }
.photo-count { color: var(--color-muted); font-size: 22rpx; }
.photo-grid { display: flex; flex-wrap: wrap; margin-top: 20rpx; }
.photo-grid > view + view { margin-left: 12rpx; }
.photo-grid > view:nth-child(4n + 1) { margin-left: 0; }
.photo-item, .photo-add { width: calc(25% - 9rpx); }
.photo-item, .photo-add { height: 132rpx; border-radius: 16rpx; overflow: hidden; }
.photo-item image { width: 100%; height: 100%; display: block; }
.photo-placeholder { width: 100%; height: 100%; display: flex; flex-direction: column; justify-content: center; align-items: center; background: #FFF7E8; color: var(--color-muted); font-size: 42rpx; }
.photo-placeholder text { font-size: 18rpx; }
.photo-add { background: #FFF2F5; color: var(--color-primary-dark); display: flex; justify-content: center; align-items: center; font-size: 28rpx; text-align: center; }
.photo-add--disabled { opacity: .5; }
.upload-hint { display: block; margin-top: 18rpx; color: var(--color-muted); font-size: 21rpx; }
.form-card { padding-top: 8rpx; padding-bottom: 8rpx; }
.form-row { min-height: 98rpx; display: flex; align-items: center; justify-content: space-between; border-bottom: 1rpx solid #F5EDF2; }
.picker-value { color: var(--color-text); font-size: 26rpx; }
.picker-value text { color: var(--color-muted); margin-left: 8rpx; }
.form-column { padding: 22rpx 0; }
.form-textarea { margin-top: 16rpx; width: 100%; min-height: 150rpx; background: #FFF9FB; border-radius: 18rpx; padding: 18rpx; color: var(--color-text); font-size: 25rpx; }
.tag-input { margin-top: 16rpx; width: 100%; background: #FFF9FB; border-radius: 18rpx; padding: 18rpx; color: var(--color-text); font-size: 25rpx; }
.save-button { width: 80%; margin: 36rpx auto 0; }
