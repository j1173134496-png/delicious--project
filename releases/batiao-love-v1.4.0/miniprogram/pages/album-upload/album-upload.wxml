<view class="safe-page upload-page">
  <nav-bar title="上传照片" showBack="{{true}}" />
  <view class="upload-card card"><view class="upload-head"><text class="form-label">选择照片</text><text class="photo-count">{{images.length}} / 9（最多 9 张）</text></view><view class="photo-grid"><view wx:for="{{imageItems}}" wx:key="path" class="photo-item"><image wx:if="{{item.hasImage}}" src="{{item.imagePath}}" mode="aspectFill" binderror="onImageError" data-index="{{index}}" /><view wx:else class="photo-placeholder">📷<text>照片占位</text></view></view><view class="photo-add {{choosingImage ? 'photo-add--disabled' : ''}}" aria-label="选择照片" bindtap="chooseImage">＋ 选择照片</view></view><text class="upload-hint">一次最多选择 9 张，可以从相册选择或拍照。</text><text class="hint capability-hint" wx:if="{{!capabilities.chooseImage}}">当前环境不能选图，可先填写日期和文字说明。</text></view>
  <view class="form-card card"><view class="form-row"><text class="form-label">日期</text><picker mode="date" value="{{date}}" start="2000-01-01" end="{{today}}" bindchange="onDateChange"><view class="picker-value">{{date}} <text>⌄</text></view></picker></view><view class="form-column"><text class="form-label">描述</text><textarea class="form-textarea" maxlength="200" value="{{description}}" bindinput="onDescriptionInput" placeholder="这一天发生了什么呀？" /></view><view class="form-column"><text class="form-label">标签</text><input class="tag-input" maxlength="60" value="{{tagText}}" bindinput="onTagInput" placeholder="用逗号分隔，例如：旅行,晚餐" /></view></view>
  <button class="primary-button save-button" loading="{{saving}}" disabled="{{saving}}" bindtap="save">保存回忆</button>
</view>
