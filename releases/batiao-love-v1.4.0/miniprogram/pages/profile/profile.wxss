.profile-page { padding-top: 12rpx; }
.profile-hero { padding: 30rpx; display: flex; align-items: center; }
.profile-hero > .profile-hero__copy, .profile-hero > .edit-link { margin-left: 22rpx; }
.profile-hero__avatar, .profile-hero > .edit-link { flex-shrink: 0; }
.profile-hero__copy { flex: 1; min-width: 0; display: flex; flex-direction: column; }
.profile-hero__copy text + text { margin-top: 10rpx; }
.profile-name { color: var(--color-title); font-size: 38rpx; font-weight: 700; }
.profile-signature { display: block; min-width: 0; overflow: hidden; color: var(--color-muted); font-size: 23rpx; text-overflow: ellipsis; white-space: nowrap; }
.profile-info { margin-top: 24rpx; padding: 8rpx 28rpx; }
.info-row { min-height: 72rpx; display: flex; align-items: center; justify-content: space-between; color: var(--color-text); font-size: 24rpx; border-bottom: 1rpx solid #F5EDF2; }
.info-row:last-child { border-bottom: 0; }
.info-row text:last-child { color: var(--color-muted); }
.edit-link, .section-link { color: var(--color-primary-dark); background: transparent; font-size: 24rpx; }
.couple-card, .stats-card, .menu-card { margin-top: 24rpx; padding: 28rpx; }
.section-head { display: flex; align-items: center; justify-content: space-between; }
.section-title { font-size: 30rpx; font-weight: 700; color: var(--color-title); }
.couple-avatars { display: flex; align-items: center; justify-content: center; padding: 26rpx 0 14rpx; }
.couple-avatars > avatar + text, .couple-avatars > text + avatar { margin-left: 26rpx; }
.couple-heart { color: var(--color-primary-dark); font-size: 38rpx; animation: pulse-soft 1.8s ease-in-out infinite; }
.couple-status { display: block; text-align: center; color: var(--color-title); font-size: 25rpx; }
.accent { color: var(--color-primary-dark); font-size: 34rpx; font-weight: 700; }
.couple-button { display: block; margin: 24rpx auto 0; width: 72%; font-size: 25rpx; }
.profile-share-button { display: block; margin: 14rpx auto 0; width: 72%; font-size: 24rpx; }
.cat-summary { display: flex; align-items: center; margin: 22rpx 0; }
.cat-summary > .cat-summary__copy { margin-left: 18rpx; }
.cat-summary-visual { width: 100rpx; height: 100rpx; display: flex; align-items: center; justify-content: center; flex: 0 0 100rpx; }
.cat-summary-image { width: 100%; height: 100%; display: block; }
.cat-emoji { width: 86rpx; height: 86rpx; border-radius: 26rpx; background: var(--color-yellow); display: flex; align-items: center; justify-content: center; font-size: 52rpx; }
.cat-summary__copy { flex: 1; color: var(--color-muted); font-size: 23rpx; }
.cat-state { display: block; color: var(--color-muted); font-size: 22rpx; margin: 0 0 6rpx; }
.cat-state-note { display: block; color: var(--color-muted); font-size: 20rpx; line-height: 1.5; margin-bottom: 6rpx; }
.cat-transition-tip { color: var(--color-primary-dark); }
.cat-state-note:nth-of-type(3) { color: var(--color-primary-dark); }
.progress-track { height: 14rpx; background: #F4EAF3; border-radius: 999rpx; margin-top: 12rpx; overflow: hidden; }
.progress-value { height: 100%; border-radius: 999rpx; background: linear-gradient(90deg, var(--color-primary), #C9A7E8); }
.level-chip { background: var(--color-lavender); color: var(--color-title); border-radius: 999rpx; padding: 8rpx 16rpx; font-size: 22rpx; }
.stat-grid { display: flex; text-align: center; border-top: 1rpx solid #F2E7ED; padding-top: 22rpx; }
.stat-grid > view { flex: 1; display: flex; flex-direction: column; }
.stat-grid > view text + text { margin-top: 6rpx; }
.stat-number { font-size: 34rpx; color: var(--color-primary-dark); font-weight: 700; }
.stat-label { color: var(--color-muted); font-size: 22rpx; }
.stat-grid--wide { flex-wrap: wrap; }
.stat-grid--wide > view { min-width: 20%; padding: 0 4rpx; box-sizing: border-box; }
.growth-next { margin-top: 24rpx; padding-top: 22rpx; border-top: 1rpx solid #F2E7ED; }
.growth-complete, .next-title { color: var(--color-title); font-size: 25rpx; font-weight: 700; }
.condition-row { display: flex; align-items: center; margin-top: 16rpx; color: var(--color-muted); font-size: 22rpx; }
.condition-row > text:nth-child(1) { flex: 1; }
.condition-row > text + text { margin-left: 12rpx; }
.condition-remaining { color: var(--color-primary-dark); }
.condition-ready { color: #5C9D76; }
.menu-row { min-height: 88rpx; display: flex; align-items: center; color: var(--color-title); border-bottom: 1rpx solid #F5EDF2; }
.menu-row > text + text { margin-left: 16rpx; }
.menu-row:last-child { border-bottom: 0; }
.menu-icon { font-size: 34rpx; }
.menu-arrow { margin-left: auto; color: var(--color-muted); font-size: 38rpx; }
