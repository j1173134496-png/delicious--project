.chat-page { padding: 24rpx 24rpx 142rpx; padding-bottom: calc(142rpx + env(safe-area-inset-bottom)); position: relative; overflow: hidden; }
.initialization-error { margin: 0 0 20rpx; padding: 20rpx; border-radius: 18rpx; background: #FFF4E5; color: #8A5A20; }
.initialization-error__title, .initialization-error__body { display: block; }
.initialization-error__title { font-weight: 700; }
.initialization-error__body { margin-top: 8rpx; font-size: 22rpx; }
.initialization-error__button { margin-top: 14rpx; width: 180rpx; padding: 8rpx 0; color: #8A5A20; border: 2rpx solid #E9C892; border-radius: 999rpx; background: #FFF; font-size: 22rpx; }
.chat-title-row { display: flex; justify-content: space-between; align-items: flex-start; padding: 12rpx 6rpx 20rpx; }
.page-title { display: block; }
.level-badge { background: var(--color-lavender); color: var(--color-title); border-radius: 999rpx; padding: 12rpx 18rpx; font-size: 22rpx; margin-top: 10rpx; }
.cat-card { overflow: hidden; padding: 0 26rpx 24rpx; background: linear-gradient(160deg, #FFF, #FFF4F8); }
.cat-accessibility-note { margin: 8rpx 8rpx 0; color: var(--color-muted); font-size: 20rpx; line-height: 1.5; text-align: center; }
.cat-accessibility-note text { display: block; }
.cat-accessibility-note text + text { margin-top: 4rpx; color: var(--color-primary-dark); }
.status-row { display: flex; align-items: center; }
.status-row > .status-item + .status-item { margin-left: 18rpx; }
.status-item { flex: 1; color: var(--color-muted); font-size: 20rpx; display: flex; align-items: center; }
.status-item > text + view, .status-item > view + text, .status-item > text + .feed-count { margin-left: 7rpx; }
.status-item:first-child, .status-item:nth-child(2) { flex-direction: column; align-items: stretch; }
.status-item > text:last-child { text-align: right; color: var(--color-primary-dark); font-size: 20rpx; }
.mini-track { height: 12rpx; background: #F7E9E9; border-radius: 999rpx; overflow: hidden; }
.mini-track view { height: 100%; background: var(--color-primary); border-radius: 999rpx; }
.mini-track--mood view { background: #C9A7E8; }
.feed-count { text-align: center; color: var(--color-primary-dark); font-size: 28rpx !important; font-weight: 700; }
.experience-bar { margin-top: 24rpx; color: var(--color-muted); font-size: 21rpx; }
.experience-bar__head { display: flex; justify-content: space-between; align-items: center; }
.experience-bar__head text:last-child { color: var(--color-primary-dark); font-weight: 700; }
.experience-track { height: 14rpx; background: #F4EAF3; border-radius: 999rpx; overflow: hidden; margin-top: 10rpx; }
.experience-value { height: 100%; border-radius: 999rpx; background: linear-gradient(90deg, #F0A0B9, #C9A7E8); }
.cat-actions { display: flex; justify-content: center; margin-top: 22rpx; }
.cat-actions > button + button { margin-left: 20rpx; }
.cat-actions button { min-width: 200rpx; font-size: 25rpx; }
.cat-actions .ghost-button { border: 2rpx solid #F2D8E1; border-radius: 999rpx; }
.care-tip { margin: 20rpx 0 0; background: #FFF9DF; color: #AB8233; border-radius: 18rpx; padding: 18rpx 20rpx; font-size: 23rpx; text-align: center; }
.upgrade-tip { margin: 20rpx 0 0; background: #F4ECFF; color: #8054A7; border-radius: 18rpx; padding: 18rpx 20rpx; font-size: 23rpx; text-align: center; }
.message-scroll { height: 530rpx; margin-top: 22rpx; padding: 10rpx 6rpx; }
.chat-empty { height: 100%; display: flex; align-items: center; justify-content: center; flex-direction: column; color: var(--color-muted); }
.chat-empty > text + text { margin-top: 12rpx; }
.chat-empty text:first-child { font-size: 60rpx; }
.chat-bottom { height: 2rpx; }
.input-bar { position: fixed; z-index: 8; left: 20rpx; right: 20rpx; bottom: 20rpx; bottom: calc(20rpx + env(safe-area-inset-bottom)); background: #fff; border-radius: 999rpx; box-shadow: 0 8rpx 30rpx rgba(164, 104, 137, .16); display: flex; align-items: center; padding: 10rpx 12rpx 10rpx 24rpx; }
.chat-input { flex: 1; color: var(--color-text); font-size: 25rpx; min-width: 0; }
.send-button { width: 116rpx; background: var(--color-primary); color: #fff; border-radius: 999rpx; font-size: 24rpx; padding: 15rpx 0; }
.heart-layer { position: fixed; pointer-events: none; left: 0; right: 0; bottom: 360rpx; height: 160rpx; z-index: 10; }
.heart { position: absolute; color: var(--color-primary-dark); font-size: 34rpx; opacity: 0; animation: heart-rise 1.5s ease-out forwards; }
