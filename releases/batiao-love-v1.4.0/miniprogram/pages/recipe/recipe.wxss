.recipe-page { padding: 24rpx 24rpx 150rpx; padding-bottom: calc(150rpx + env(safe-area-inset-bottom)); }
.recipe-header { display: flex; align-items: flex-start; justify-content: space-between; padding: 12rpx 6rpx 22rpx; }
.recipe-total { color: var(--color-primary-dark); font-size: 22rpx; margin-top: 28rpx; }
.recipe-tabs { display: flex; padding: 10rpx; margin-bottom: 24rpx; }
.recipe-tab { flex: 1; text-align: center; color: var(--color-muted); font-size: 25rpx; padding: 16rpx 4rpx; border-radius: 18rpx; position: relative; }
.recipe-tab-count { display: block; margin: 4rpx 0 0; font-size: 20rpx; }
.recipe-tab-state { display: block; margin-top: 3rpx; color: var(--color-primary-dark); font-size: 18rpx; }
.recipe-tab--active { color: var(--color-title); background: var(--color-lavender); font-weight: 700; }
.recipe-grid { display: flex; flex-wrap: wrap; }
.recipe-grid recipe-card { width: calc(50% - 10rpx); }
.recipe-grid recipe-card:nth-child(2n) { margin-left: 20rpx; }
.floating-add { position: fixed; z-index: 10; right: 30rpx; bottom: 140rpx; bottom: calc(140rpx + env(safe-area-inset-bottom)); min-width: 104rpx; width: auto; padding: 0 22rpx; height: 104rpx; border-radius: 52rpx; color: #fff; background: var(--color-primary-dark); box-shadow: 0 10rpx 24rpx rgba(232, 111, 145, .3); font-size: 28rpx; line-height: 96rpx; }
