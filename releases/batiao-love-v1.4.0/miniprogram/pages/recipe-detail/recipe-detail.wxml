<view class="safe-page detail-page">
  <nav-bar title="菜品详情" showBack="{{true}}" />
  <view wx:if="{{recipe.recipeId}}">
    <swiper class="photo-swiper" aria-label="菜品照片预览" indicator-dots="true" circular="true" wx:if="{{photoItems.length}}"><swiper-item wx:for="{{photoItems}}" wx:key="path"><image wx:if="{{item.hasImage}}" src="{{item.imagePath}}" mode="aspectFill" data-index="{{index}}" binderror="onPhotoError" /><view wx:else class="detail-placeholder">📷<text>照片占位</text></view></swiper-item></swiper>
    <view class="photo-empty card" wx:else><text>🍽️</text><text wx:if="{{recipe.isUnlocked}}">还没有照片，先把菜名收藏起来吧</text><text wx:else>🔒 还没吃过哦~</text><text class="lock-hint" wx:if="{{!recipe.isUnlocked}}">补充照片解锁</text><button class="secondary-button" loading="{{addingPhoto}}" disabled="{{addingPhoto || deleting}}" bindtap="choosePhoto">{{recipe.isUnlocked ? '补充照片' : '补充照片解锁'}}</button></view>
    <view class="detail-card card"><view class="detail-title-row"><view><text class="detail-name">{{recipe.name}}</text><text class="detail-category">{{recipe.category === 'dessert' ? '甜品区' : recipe.category === 'hunan' ? '湘菜' : '自定义'}}</text></view><button class="edit-button" aria-label="编辑菜品" disabled="{{updating || deleting}}" bindtap="edit">编辑菜品</button></view><view class="lock-state" wx:if="{{!recipe.isUnlocked}}"><text class="lock-badge">🔒 还没吃过哦~</text><text class="lock-hint">补充照片解锁后即可评分和点赞</text></view><view class="rating-row" wx:if="{{recipe.isUnlocked}}"><text class="heart-rating" wx:for="{{ratingValues}}" wx:key="*this" data-rating="{{item}}" aria-label="评分 {{item}} / 5" bindtap="rate">{{item <= recipe.rating ? '♥' : '♡'}}</text><text class="rating-hint">评分 {{recipe.rating || 0}} / 5</text></view><text class="review" wx:if="{{recipe.review}}">“{{recipe.review}}”</text><text class="date" wx:if="{{recipe.unlockedDate}}">解锁于 {{recipe.unlockedDate}}</text><view class="detail-actions" wx:if="{{recipe.isUnlocked}}"><button class="like-button {{liked ? 'like-button--active' : ''}}" aria-label="{{liked ? '取消点赞' : '点赞'}}，共 {{recipe.likes.length}} 次" loading="{{updating}}" disabled="{{updating || deleting}}" bindtap="toggleLike">{{liked ? '取消点赞' : '点赞'}} {{recipe.likes.length}}</button><button class="danger-link" loading="{{deleting}}" disabled="{{deleting || updating}}" bindtap="remove">删除这道菜</button></view><view class="detail-actions" wx:else><text class="locked-actions">补充照片后可评分和点赞</text><button class="danger-link" loading="{{deleting}}" disabled="{{deleting || updating}}" bindtap="remove">删除这道菜</button></view></view>
  </view>
  <empty-state wx:else icon="🍳" text="找不到这道菜" actionText="回到菜谱图鉴" bind:action="goRecipe" />
</view>
