.about-page { padding-top: 12rpx; }
.about-scroll { height: calc(100vh - 96rpx); padding: 0 24rpx 40rpx; box-sizing: border-box; }
.intro-card, .content-card { margin-top: 24rpx; padding: 30rpx; }
.intro-card { display: flex; flex-direction: column; align-items: center; text-align: center; }
.intro-emoji { font-size: 70rpx; }
.intro-card .page-title { margin-top: 18rpx; }
.intro-card .page-subtitle { margin-top: 12rpx; }
.content-card { display: flex; flex-direction: column; }
.section-title { color: var(--color-title); font-size: 30rpx; font-weight: 700; }
.body-text { color: var(--color-text); font-size: 25rpx; line-height: 1.75; margin-top: 18rpx; }
.action-hint { display: block; color: var(--color-muted); font-size: 21rpx; text-align: center; margin: 24rpx 24rpx 0; }
.about-scroll > .primary-button { display: block; width: 80%; margin: 28rpx auto 50rpx; }
