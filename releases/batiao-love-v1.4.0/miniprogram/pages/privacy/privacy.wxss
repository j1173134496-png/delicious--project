.privacy-page { padding-top: 12rpx; }
.privacy-scroll { height: calc(100vh - 96rpx); padding: 0 24rpx 40rpx; box-sizing: border-box; }
.content-card { margin-top: 24rpx; padding: 30rpx; display: flex; flex-direction: column; }
.section-title { color: var(--color-title); font-size: 30rpx; font-weight: 700; }
.body-text { color: var(--color-text); font-size: 25rpx; line-height: 1.75; margin-top: 18rpx; }
.action-hint { display: block; color: var(--color-muted); font-size: 21rpx; line-height: 1.5; text-align: center; margin: 24rpx 24rpx 0; }
.privacy-scroll > .secondary-button { display: block; width: 80%; margin: 28rpx auto 50rpx; }
