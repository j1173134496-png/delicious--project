.edit-page { padding-top: 12rpx; }
.avatar-editor { padding: 34rpx; display: flex; flex-direction: column; align-items: center; }
.avatar-editor .avatar-hint { margin-top: 14rpx; }
.avatar-hint { color: var(--color-muted); font-size: 23rpx; }
.form-card { margin-top: 24rpx; padding: 10rpx 28rpx; }
.form-row { min-height: 98rpx; display: flex; align-items: center; border-bottom: 1rpx solid #F5EDF2; }
.form-row > input, .form-row > picker { margin-left: 22rpx; }
.form-column { padding: 22rpx 0; }
.form-label { width: 180rpx; color: var(--color-title); font-size: 27rpx; }
.form-input, .picker-value { flex: 1; color: var(--color-text); text-align: right; font-size: 27rpx; }
.picker-value text { color: var(--color-muted); margin-left: 8rpx; }
.form-textarea { margin-top: 18rpx; width: 100%; min-height: 150rpx; background: #FFF9FB; border-radius: 18rpx; padding: 18rpx; color: var(--color-text); font-size: 26rpx; }
.save-button { width: 80%; margin: 40rpx auto 0; }
