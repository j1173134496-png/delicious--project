<view class="safe-page album-page">
  <view class="album-hero card"><view class="album-couple"><avatar size="small" avatar="{{user.avatar}}" fallback="🐰" /><text>♥</text><avatar size="small" avatar="{{isBound ? couple.partner.avatar : ''}}" fallback="{{isBound ? '🌷' : '？'}}" /></view><text class="together" wx:if="{{isBound}}">在一起的第 <text>{{togetherDays}}</text> 天</text><text class="together together--empty" wx:else>先绑定 Ta，再开始记录共同的第 1 天</text><button class="ghost-button bind-album-button" wx:if="{{!isBound}}" bindtap="goBind">邀请 Ta 一起记录</button><view class="album-summary"><text>共收藏 {{total}} 张照片</text><text class="signature" aria-label="编辑相册签名" wx:if="{{!editingSignature}}" bindtap="editSignature">{{signature}} · 编辑签名</text><view class="signature-editor" wx:else><input value="{{signatureDraft}}" maxlength="60" bindinput="onSignatureInput" placeholder="写一句甜甜的话" /><view><button class="ghost-button" loading="{{savingSignature}}" disabled="{{savingSignature}}" bindtap="saveSignature">保存签名</button><button class="ghost-button" disabled="{{savingSignature}}" bindtap="cancelSignature">取消编辑</button></view></view></view></view>
  <text class="hint capability-hint" wx:if="{{!capabilities.saveImageToPhotosAlbum}}">当前环境暂不支持保存到系统相册，仍可在小程序内预览和删除记录。</text>
  <view wx:if="{{groups.length}}"><view wx:for="{{groups}}" wx:key="month" class="month-section"><view class="month-title"><text>♡ {{item.label}}</text><text>{{item.photos.length}} 张</text></view><view class="photo-grid"><photo-card wx:for="{{item.photos}}" wx:key="photoId" photo="{{item}}" bind:select="preview" bind:save="saveToAlbum" /></view></view></view>
  <empty-state wx:else icon="📷" text="还没有你们的照片" actionText="上传第一张" bind:action="goUpload" />
  <button class="floating-add" aria-label="上传照片" bindtap="goUpload">＋ 上传照片</button>

  <view class="preview-overlay" wx:if="{{previewVisible}}"><view class="preview-top"><button class="preview-close" aria-label="关闭照片预览" bindtap="closePreview">× 关闭</button><text>{{previewIndex + 1}} / {{previewPhotos.length}}</text></view><swiper class="preview-swiper" aria-label="照片预览，可左右滑动" current="{{previewIndex}}" circular="false" bindchange="onPreviewChange"><swiper-item wx:for="{{previewPhotos}}" wx:key="photoId"><image wx:if="{{item.hasImage}}" src="{{item.renderPath}}" mode="aspectFit" data-index="{{index}}" binderror="onPreviewError" bindlongpress="saveCurrent" /><view wx:else class="preview-placeholder">📷<text>照片占位</text></view></swiper-item></swiper><view class="preview-caption"><text>{{currentPhoto.description || '没有描述，也是一段可爱的回忆'}}</text><text>{{currentPhoto.date}}</text><text>上传者：{{currentPhoto.uploaderLabel || '本机记录'}}</text><text class="preview-save-hint">长按照片可尝试保存到系统相册；能力不可用时请按上方提示处理。</text><button wx:if="{{canDelete}}" class="preview-delete" bindtap="deleteCurrent">删除这张照片</button></view></view>
</view>
