.add-page { padding-top: 12rpx; }
.form-card, .photo-picker { padding: 10rpx 28rpx; margin-bottom: 24rpx; }
.form-row { min-height: 98rpx; display: flex; align-items: center; border-bottom: 1rpx solid #F5EDF2; }
.form-row > input, .form-row > picker { margin-left: 22rpx; }
.form-column { padding: 22rpx 0; }
.form-label { color: var(--color-title); font-size: 27rpx; }
.form-row .form-label { width: 160rpx; }
.form-input, .picker-value { flex: 1; text-align: right; color: var(--color-text); font-size: 26rpx; }
.picker-value text { color: var(--color-muted); margin-left: 8rpx; }
.rating-readable { display: block; margin-top: 8rpx; color: var(--color-muted); font-size: 21rpx; }
.rating-picker { display: flex; margin-top: 12rpx; }
.rating-picker text + text { margin-left: 13rpx; }
.rating-picker text { color: #EFA4B3; font-size: 48rpx; }
.form-textarea { margin-top: 16rpx; width: 100%; min-height: 150rpx; background: #FFF9FB; border-radius: 18rpx; padding: 18rpx; color: var(--color-text); font-size: 25rpx; }
.photo-picker { padding-top: 24rpx; padding-bottom: 24rpx; }
.photo-picker-head { display: flex; justify-content: space-between; align-items: center; }
.photo-count { color: var(--color-muted); font-size: 22rpx; }
.photo-grid { display: flex; flex-wrap: wrap; margin-top: 18rpx; }
.photo-grid .photo-item:nth-child(4n), .photo-grid .photo-add:nth-child(4n) { margin-left: 12rpx; }
.photo-grid > view:nth-child(4n + 1) { margin-left: 0; }
.photo-grid > view:not(:nth-child(4n + 1)) { margin-left: 12rpx; }
.photo-item, .photo-add { width: calc(25% - 9rpx); }
.photo-item, .photo-add { height: 132rpx; border-radius: 16rpx; overflow: hidden; }
.photo-item image { width: 100%; height: 100%; display: block; }
.photo-placeholder { width: 100%; height: 100%; display: flex; flex-direction: column; align-items: center; justify-content: center; color: var(--color-muted); background: #FFF7E8; font-size: 42rpx; }
.photo-placeholder text { margin-top: 4rpx; font-size: 18rpx; }
.photo-add { background: #FFF2F5; color: var(--color-primary-dark); display: flex; justify-content: center; align-items: center; font-size: 54rpx; }
.photo-hint { display: block; color: var(--color-muted); font-size: 21rpx; margin-top: 18rpx; }
.save-button { width: 80%; margin: 38rpx auto 0; }
