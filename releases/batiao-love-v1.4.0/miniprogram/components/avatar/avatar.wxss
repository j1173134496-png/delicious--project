.avatar { width: 112rpx; height: 112rpx; border-radius: 50%; background: linear-gradient(135deg, #FFE2EA, #E8D5F5); border: 5rpx solid #fff; box-shadow: 0 0 0 3rpx var(--color-primary); display: flex; align-items: center; justify-content: center; overflow: hidden; }
.avatar--large { width: 150rpx; height: 150rpx; }
.avatar--small { width: 90rpx; height: 90rpx; border-width: 3rpx; box-shadow: none; }
.avatar__image { display: block; width: 100%; height: 100%; }
.avatar__fallback { font-size: 62rpx; line-height: 1; }
.avatar--large .avatar__fallback { font-size: 78rpx; }
.avatar--small .avatar__fallback { font-size: 45rpx; }
